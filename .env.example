# --- SpareBank 1 personal client (https://developer.sparebank1.no) ---
SB1_CLIENT_ID=
SB1_CLIENT_SECRET=
# Optional. Your bank, e.g. fid-smn, fid-ostlandet, fid-sr-bank, fid-nord-norge.
SB1_FIN_INST=
# Money transfers are off by default. Set to true to expose the transfer tools.
SB1_ENABLE_TRANSFERS=false

# --- This server ---
# The https address the server is reached on. No trailing slash.
# The redirect URI to register with SpareBank 1 is PUBLIC_URL + /sparebank1/callback
PUBLIC_URL=https://sb1-mcp.example.com
# Password for approving MCP clients and for the BankID login. At least 16 characters.
#   openssl rand -base64 24
ADMIN_PASSWORD=
# Encrypts the stored tokens. 32 bytes, base64 or hex.
#   openssl rand -base64 32
ENCRYPTION_KEY=
# Optional. A fixed bearer token for clients that cannot do OAuth. At least 32 characters.
#   openssl rand -base64 48
MCP_STATIC_TOKEN=

# Number of reverse proxies in front of the server (Traefik in Dokploy = 1).
# TRUST_PROXY=1
# PORT=3000
# DATA_DIR=./data
